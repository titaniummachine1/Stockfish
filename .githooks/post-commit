#!/bin/sh
# Enable: git config core.hooksPath .githooks
ROOT="$(git rev-parse --show-toplevel)"
if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -File "$ROOT/scripts/post-commit-build-test.ps1"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$ROOT/scripts/post-commit-build-test.ps1"
else
  cd "$ROOT/src" && make -j build && cd "$ROOT/tests" && python3 instrumented.py --none ../src/stockfish
fi
